# Network topology and per-service runtime settings.
#
# TOPOLOGY (2026-08-06): four services — velocity, lobby, survival, maintenance.
# The pvp backend was retired; contested PVP is now served by the in-survival RTP
# duel queue (/rtpq). The lobby doubles as the hold area while survival restarts,
# so this network does not run a separate limbo backend. (PizzaLimbo source is
# kept in plugins-src/ for deployments that have no lobby.)
#
# ALL_BACKENDS below is the single source of truth for "which Paper backends exist".
# Add a backend here and the ops scripts pick it up; do not hardcode lists in scripts.

ENABLE_DB=1
ENABLE_VELOCITY=1
ENABLE_LOBBY=1
ENABLE_SURVIVAL=1
ENABLE_MAINTENANCE=1
# dev: plugin development/test backend. Off by default; start on demand with
# ./scripts/start_only.sh dev. Never in the player-facing fallback chain.
ENABLE_DEV=0
ENABLE_WEBUI=0
AUTH_MODE=offline
SAFE_MODE=1
DIAG_MINIMAL_LOBBY=0

# Every Paper backend in this network, in startup order.
ALL_BACKENDS='lobby survival maintenance dev'

# Java runtime used by startup scripts (set absolute path to avoid sudo PATH differences)
JAVA_BIN="${JAVA_BIN:-$(command -v java)}"

# Ports
VELOCITY_PORT=25565
LOBBY_PORT=25566
SURVIVAL_PORT=25567
MAINTENANCE_PORT=25569
# 25568 was the retired pvp port; reused for dev.
DEV_PORT=25568
DB_PORT=3306
WEBUI_PORT=8989

# Java opts per service.
#
# These OVERRIDE the defaults inside each scripts/start_<svc>.sh. The previous values
# here were a bare '-Xms.. -Xmx.. -XX:+UseG1GC', which silently shadowed the full
# Aikar G1 tuning those scripts fall back to — so the network ran untuned. The tuning
# is now spelled out here so what you read is what actually runs.
#
# Memory policy: -Xms is deliberately LOW and AlwaysPreTouch is deliberately ABSENT,
# so each JVM commits pages lazily instead of grabbing its whole heap at boot. That
# trades a little early-game GC for a much smaller resident footprint on a workstation
# that is also running a browser, Discord and a Minecraft client. If this ever moves to
# a dedicated box, set -Xms == -Xmx and add -XX:+AlwaysPreTouch for steadier tick times.
#
# Ceilings: velocity 512M + lobby 1536M + survival 4G = 6G max with ~1.75G committed at
# boot (was 8G max / 3.5G committed).
# -XX:+UnlockExperimentalVMOptions MUST come first and MUST be present: G1NewSizePercent,
# G1MaxNewSizePercent and G1MixedGCLiveThresholdPercent are experimental flags, and the
# JVM refuses to boot without the unlock ("Could not create the Java Virtual Machine").
AIKAR_G1='-XX:+UnlockExperimentalVMOptions -XX:+UseG1GC -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -XX:+UseStringDeduplication -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true'

# The proxy holds no world data — it needs very little heap.
VELOCITY_JAVA_OPTS="-Xms256M -Xmx512M -XX:+UseG1GC -XX:+UseStringDeduplication"
LOBBY_JAVA_OPTS="-Xms512M -Xmx1536M $AIKAR_G1"
SURVIVAL_JAVA_OPTS="-Xms1G -Xmx4G $AIKAR_G1"
MAINTENANCE_JAVA_OPTS="-Xms512M -Xmx1G $AIKAR_G1"
DEV_JAVA_OPTS="-Xms512M -Xmx2G $AIKAR_G1"
