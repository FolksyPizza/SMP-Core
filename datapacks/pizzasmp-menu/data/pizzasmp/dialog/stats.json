{
  "type": "minecraft:multi_action",
  "title": { "text": "Player Stats", "color": "#00BFFF", "bold": true },
  "external_title": "Player Stats",
  "pause": false,
  "can_close_with_escape": true,
  "after_action": "close",
  "columns": 1,
  "inputs": [
    { "type": "minecraft:text", "key": "player", "label": "Player Name", "width": 300, "max_length": 16 }
  ],
  "actions": [
    {
      "label": { "text": "View Profile", "color": "green" },
      "width": 220,
      "action": { "type": "dynamic/run_command", "template": "stats $(player)" }
    }
  ],
  "exit_action": { "label": "Back", "width": 220, "action": { "type": "show_dialog", "dialog": "pizzasmp:menu" } }
}
