{
  "type": "minecraft:multi_action",
  "title": { "text": "Teleport Request", "color": "#00BFFF", "bold": true },
  "external_title": "Teleport Request",
  "pause": false,
  "can_close_with_escape": true,
  "after_action": "close",
  "columns": 1,
  "inputs": [
    { "type": "minecraft:text", "key": "player", "label": "Player Name", "width": 300, "max_length": 16 },
    {
      "type": "minecraft:single_option",
      "key": "direction",
      "label": "Direction",
      "label_visible": false,
      "width": 300,
      "options": [
        { "id": "tpa", "display": "Direction: Teleport to player", "initial": true },
        { "id": "tpahere", "display": "Direction: Teleport player to me" }
      ]
    }
  ],
  "actions": [
    {
      "label": { "text": "Send Request", "color": "green" },
      "width": 220,
      "action": { "type": "dynamic/run_command", "template": "$(direction) $(player)" }
    }
  ],
  "exit_action": { "label": "Back", "width": 220, "action": { "type": "show_dialog", "dialog": "pizzasmp:menu" } }
}
